{
  "name": "Loker Dunia",
  "description": "Papan lowongan kerja global dengan pencocokan skill dan sertifikat",
  "secrets": [],
  "tests": [
    { "name": "Home lists latest jobs", "path": "/", "expectSelector": "[data-testid=job-card]", "expectText": "Lowongan terbaru" },
    {
      "id": "jobs.search",
      "name": "Job search renders job cards",
      "path": "/#/jobs",
      "expectSelector": "#results [data-testid=job-card]",
      "visual": true,
      "impact": ["public/index.html"]
    },
    { "name": "Job detail shows required skills and apply", "path": "/#/job/j1", "expectSelector": "[data-testid=job-skill-lists]", "expectText": "Lamar Sekarang" },
    { "name": "Most wanted skills ranking", "path": "/#/skills", "expectSelector": "[data-testid=skill-ranking] li" },
    { "name": "Explore by country", "path": "/#/countries", "expectSelector": "[data-testid=country-grid] button" },
    { "name": "Sign up offers both roles", "path": "/#/auth", "expectSelector": "[data-testid=role-choice]", "expectText": "Perusahaan" },
    { "name": "Saved page empty state", "path": "/#/saved", "expectText": "Belum ada lowongan tersimpan" }
  ]
}
